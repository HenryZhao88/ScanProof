# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Datasets (reproducible via `make data` / medmnist API) — never commit raw medical data
data/
!data/.gitkeep

# Model weights (reproducible via `make train`)
models/
!models/.gitkeep

# Per-case audit rows are regenerated by `make audit`; only the small summary is committed
artifacts/audit_cases.json
artifacts/shift_cases.json
artifacts/*.npz

# Frontend
node_modules/
frontend/dist/
frontend/.vite/
dist/
*.tsbuildinfo

# Agent tooling dropped in by the harness, not part of this project
.agents/
.claude/skills/
skills-lock.json

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Scratch
scratch/
*.log

# Local docs and harness state
.claude/
docs/
